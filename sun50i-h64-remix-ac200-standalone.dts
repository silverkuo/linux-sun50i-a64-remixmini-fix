/dts-v1/;

/ {
  interrupt-parent = <0x01>;
  #address-cells = <0x01>;
  #size-cells = <0x01>;
  model = "Remix Mini PC";
  compatible = "jide,remix-mini-pc", "allwinner,sun50i-h64", "allwinner,sun50i-a64";
  aliases {
    mmc0 = "/soc/mmc@1c0f000";
    mmc1 = "/soc/mmc@1c10000";
    mmc2 = "/soc/mmc@1c11000";
    ethernet1 = "/soc/mmc@1c10000/wifi@1";
    serial0 = "/soc/serial@1c28000";
  };
  chosen {
    #address-cells = <0x01>;
    #size-cells = <0x01>;
    ranges;
    stdout-path = "serial0:115200n8";
    framebuffer-lcd {
      compatible = "allwinner,simple-framebuffer", "simple-framebuffer";
      allwinner,pipeline = "mixer0-lcd0";
      clocks = <0x02 0x64 0x03 0x06>;
      status = "disabled";
      phandle = <0x4f>;
    };
    framebuffer-hdmi {
      compatible = "allwinner,simple-framebuffer", "simple-framebuffer";
      allwinner,pipeline = "mixer1-lcd1-hdmi";
      clocks = <0x03 0x07 0x02 0x65 0x02 0x6e>;
      status = "disabled";
      vcc-hdmi-supply = <0x04>;
      phandle = <0x50>;
    };
  };
  cpus {
    #address-cells = <0x01>;
    #size-cells = "", "", "", "";
    cpu@0 {
      compatible = "arm,cortex-a53";
      device_type = "cpu";
      reg = "", "", "", "";
      enable-method = "psci";
      clocks = <0x02 0x15>;
      clock-names = "cpu";
      #cooling-cells = <0x02>;
      i-cache-size = <0x8000>;
      i-cache-line-size = <0x40>;
      i-cache-sets = <0x100>;
      d-cache-size = <0x8000>;
      d-cache-line-size = <0x40>;
      d-cache-sets = <0x80>;
      next-level-cache = <0x05>;
      operating-points-v2 = <0x06>;
      cpu-supply = <0x07>;
      phandle = <0x0a>;
    };
    cpu@1 {
      compatible = "arm,cortex-a53";
      device_type = "cpu";
      reg = <0x01>;
      enable-method = "psci";
      clocks = <0x02 0x15>;
      clock-names = "cpu";
      #cooling-cells = <0x02>;
      i-cache-size = <0x8000>;
      i-cache-line-size = <0x40>;
      i-cache-sets = <0x100>;
      d-cache-size = <0x8000>;
      d-cache-line-size = <0x40>;
      d-cache-sets = <0x80>;
      next-level-cache = <0x05>;
      operating-points-v2 = <0x06>;
      cpu-supply = <0x07>;
      phandle = <0x0b>;
    };
    cpu@2 {
      compatible = "arm,cortex-a53";
      device_type = "cpu";
      reg = <0x02>;
      enable-method = "psci";
      clocks = <0x02 0x15>;
      clock-names = "cpu";
      #cooling-cells = <0x02>;
      i-cache-size = <0x8000>;
      i-cache-line-size = <0x40>;
      i-cache-sets = <0x100>;
      d-cache-size = <0x8000>;
      d-cache-line-size = <0x40>;
      d-cache-sets = <0x80>;
      next-level-cache = <0x05>;
      operating-points-v2 = <0x06>;
      cpu-supply = <0x07>;
      phandle = <0x0c>;
    };
    cpu@3 {
      compatible = "arm,cortex-a53";
      device_type = "cpu";
      reg = <0x03>;
      enable-method = "psci";
      clocks = <0x02 0x15>;
      clock-names = "cpu";
      #cooling-cells = <0x02>;
      i-cache-size = <0x8000>;
      i-cache-line-size = <0x40>;
      i-cache-sets = <0x100>;
      d-cache-size = <0x8000>;
      d-cache-line-size = <0x40>;
      d-cache-sets = <0x80>;
      next-level-cache = <0x05>;
      operating-points-v2 = <0x06>;
      cpu-supply = <0x07>;
      phandle = <0x0d>;
    };
    l2-cache {
      compatible = "cache";
      cache-level = <0x02>;
      cache-unified;
      cache-size = <0x80000>;
      cache-line-size = <0x40>;
      cache-sets = <0x200>;
      phandle = <0x05>;
    };
  };
  display-engine {
    compatible = "allwinner,sun50i-a64-display-engine";
    allwinner,pipelines = <0x08 0x09>;
    status = "okay";
    phandle = <0x51>;
  };
  opp-table-gpu {
    compatible = "operating-points-v2";
    phandle = <0x3e>;
    opp-432000000 {
      opp-hz = <0x00 0x19bfcc00>;
    };
  };
  osc24M-clk {
    #clock-cells = "", "", "", "";
    compatible = "fixed-clock";
    clock-frequency = <0x16e3600>;
    clock-output-names = "osc24M";
    phandle = <0x2f>;
  };
  osc32k-clk {
    #clock-cells = "", "", "", "";
    compatible = "fixed-clock";
    clock-frequency = <0x8000>;
    clock-output-names = "ext-osc32k";
    phandle = <0x48>;
  };
  pmu {
    compatible = "arm,cortex-a53-pmu";
    interrupts = <0x00 0x74 0x04 0x00 0x75 0x04 0x00 0x76 0x04 0x00 0x77 0x04>;
    interrupt-affinity = <0x0a 0x0b 0x0c 0x0d>;
  };
  psci {
    compatible = "arm,psci-0.2";
    method = "smc";
  };
  sound {
    #address-cells = <0x01>;
    #size-cells = "", "", "", "";
    compatible = "simple-audio-card";
    simple-audio-card,name = "sun50i-a64-audio";
    simple-audio-card,aux-devs = <0x0e>;
    simple-audio-card,routing = "Left DAC", "DACL", "Right DAC", "DACR", "Headphone Jack", "HP", "ADCL", "Left ADC", "ADCR", "Right ADC", "MIC2", "Microphone Jack";
    status = "okay";
    simple-audio-card,widgets = "Microphone", "Microphone Jack", "Headphone", "Headphone Jack";
    phandle = <0x52>;
    simple-audio-card,dai-link@0 {
      format = "i2s";
      frame-master = <0x0f>;
      bitclock-master = <0x0f>;
      mclk-fs = <0x80>;
      cpu {
        sound-dai = <0x10>;
        phandle = <0x0f>;
      };
      codec {
        sound-dai = <0x11 0x00>;
        phandle = <0x53>;
      };
    };
  };
  sound_hdmi {
    compatible = "allwinner,sun9i-a80-hdmi-audio", "allwinner,sun50i-a64-hdmi-audio";
    status = "disabled";
    phandle = <0x54>;
    codec {
      sound-dai = <0x12>;
    };
    cpu {
      sound-dai = <0x13>;
    };
  };
  timer {
    compatible = "arm,armv8-timer";
    allwinner,erratum-unknown1;
    arm,no-tick-in-suspend;
    interrupts = <0x01 0x0d 0xf04 0x01 0x0e 0xf04 0x01 0x0b 0xf04 0x01 0x0a 0xf04>;
  };
  thermal-zones {
    cpu0-thermal {
      polling-delay-passive = "", "", "", "";
      polling-delay = "", "", "", "";
      thermal-sensors = <0x14 0x00>;
      phandle = <0x55>;
      cooling-maps {
        map0 {
          trip = <0x15>;
          cooling-device = <0x0a 0xffffffff 0xffffffff 0x0b 0xffffffff 0xffffffff 0x0c 0xffffffff 0xffffffff 0x0d 0xffffffff 0xffffffff>;
        };
        map1 {
          trip = <0x16>;
          cooling-device = <0x0a 0xffffffff 0xffffffff 0x0b 0xffffffff 0xffffffff 0x0c 0xffffffff 0xffffffff 0x0d 0xffffffff 0xffffffff>;
        };
      };
      trips {
        cpu-alert0 {
          temperature = <0x11170>;
          hysteresis = <0x7d0>;
          type = "passive";
          phandle = <0x15>;
        };
        cpu-alert1 {
          temperature = <0x13880>;
          hysteresis = <0x7d0>;
          type = "hot";
          phandle = <0x16>;
        };
        cpu-crit {
          temperature = <0x15f90>;
          hysteresis = <0x7d0>;
          type = "critical";
          phandle = <0x56>;
        };
      };
    };
    gpu0-thermal {
      polling-delay-passive = "", "", "", "";
      polling-delay = "", "", "", "";
      thermal-sensors = <0x14 0x01>;
      phandle = <0x57>;
      trips {
        gpu0-crit {
          temperature = <0x1adb0>;
          hysteresis = <0x7d0>;
          type = "critical";
          phandle = <0x58>;
        };
      };
    };
    gpu1-thermal {
      polling-delay-passive = "", "", "", "";
      polling-delay = "", "", "", "";
      thermal-sensors = <0x14 0x02>;
      phandle = <0x59>;
      trips {
        gpu1-crit {
          temperature = <0x1adb0>;
          hysteresis = <0x7d0>;
          type = "critical";
          phandle = <0x5a>;
        };
      };
    };
  };
  soc {
    compatible = "simple-bus";
    #address-cells = <0x01>;
    #size-cells = <0x01>;
    ranges;
    bus@1000000 {
      compatible = "allwinner,sun50i-a64-de2";
      reg = <0x1000000 0x400000>;
      allwinner,sram = <0x17 0x01>;
      #address-cells = <0x01>;
      #size-cells = <0x01>;
      ranges = <0x00 0x1000000 0x400000>;
      clock@0 {
        compatible = "allwinner,sun50i-a64-de2-clk";
        reg = <0x00 0x10000>;
        clocks = <0x02 0x34 0x02 0x63>;
        clock-names = "bus", "mod";
        resets = <0x02 0x1e>;
        #clock-cells = <0x01>;
        #reset-cells = <0x01>;
        phandle = <0x03>;
      };
      rotate@20000 {
        compatible = "allwinner,sun50i-a64-de2-rotate", "allwinner,sun8i-a83t-de2-rotate";
        reg = <0x20000 0x10000>;
        interrupts = <0x00 0x60 0x04>;
        clocks = <0x03 0x09 0x03 0x0a>;
        clock-names = "bus", "mod";
        resets = <0x03 0x03>;
        phandle = <0x5b>;
      };
      mixer@100000 {
        compatible = "allwinner,sun50i-a64-de2-mixer-0";
        reg = <0x100000 0x100000>;
        clocks = <0x03 0x00 0x03 0x06>;
        clock-names = "bus", "mod";
        resets = <0x03 0x00>;
        phandle = <0x08>;
        ports {
          #address-cells = <0x01>;
          #size-cells = "", "", "", "";
          port@1 {
            #address-cells = <0x01>;
            #size-cells = "", "", "", "";
            reg = <0x01>;
            phandle = <0x5c>;
            endpoint@0 {
              reg = "", "", "", "";
              remote-endpoint = <0x18>;
              phandle = <0x1c>;
            };
            endpoint@1 {
              reg = <0x01>;
              remote-endpoint = <0x19>;
              phandle = <0x1f>;
            };
          };
        };
      };
      mixer@200000 {
        compatible = "allwinner,sun50i-a64-de2-mixer-1";
        reg = <0x200000 0x100000>;
        clocks = <0x03 0x01 0x03 0x07>;
        clock-names = "bus", "mod";
        resets = <0x03 0x01>;
        phandle = <0x09>;
        ports {
          #address-cells = <0x01>;
          #size-cells = "", "", "", "";
          port@1 {
            #address-cells = <0x01>;
            #size-cells = "", "", "", "";
            reg = <0x01>;
            phandle = <0x5d>;
            endpoint@0 {
              reg = "", "", "", "";
              remote-endpoint = <0x1a>;
              phandle = <0x1d>;
            };
            endpoint@1 {
              reg = <0x01>;
              remote-endpoint = <0x1b>;
              phandle = <0x20>;
            };
          };
        };
      };
    };
    syscon@1c00000 {
      compatible = "allwinner,sun50i-a64-system-control";
      reg = <0x1c00000 0x1000>;
      #address-cells = <0x01>;
      #size-cells = <0x01>;
      ranges;
      phandle = <0x3d>;
      sram@18000 {
        compatible = "mmio-sram";
        reg = <0x18000 0x28000>;
        #address-cells = <0x01>;
        #size-cells = <0x01>;
        ranges = <0x00 0x18000 0x28000>;
        phandle = <0x5e>;
        sram-section@0 {
          compatible = "allwinner,sun50i-a64-sram-c";
          reg = <0x00 0x28000>;
          phandle = <0x17>;
        };
      };
      sram@1d00000 {
        compatible = "mmio-sram";
        reg = <0x1d00000 0x40000>;
        #address-cells = <0x01>;
        #size-cells = <0x01>;
        ranges = <0x00 0x1d00000 0x40000>;
        phandle = <0x5f>;
        sram-section@0 {
          compatible = "allwinner,sun50i-a64-sram-c1", "allwinner,sun4i-a10-sram-c1";
          reg = <0x00 0x40000>;
          phandle = <0x22>;
        };
      };
    };
    dma-controller@1c02000 {
      compatible = "allwinner,sun50i-a64-dma";
      reg = <0x1c02000 0x1000>;
      interrupts = <0x00 0x32 0x04>;
      clocks = <0x02 0x1e>;
      dma-channels = <0x08>;
      dma-requests = <0x1b>;
      resets = <0x02 0x07>;
      #dma-cells = <0x01>;
      phandle = <0x32>;
    };
    lcd-controller@1c0c000 {
      compatible = "allwinner,sun50i-a64-tcon-lcd", "allwinner,sun8i-a83t-tcon-lcd";
      reg = <0x1c0c000 0x1000>;
      interrupts = <0x00 0x56 0x04>;
      clocks = <0x02 0x2f 0x02 0x64>;
      clock-names = "ahb", "tcon-ch0";
      clock-output-names = "tcon-data-clock";
      #clock-cells = "", "", "", "";
      assigned-clocks = <0x02 0x64>;
      assigned-clock-parents = <0x02 0x11>;
      resets = <0x02 0x18 0x02 0x23>;
      reset-names = "lcd", "lvds";
      phandle = <0x60>;
      ports {
        #address-cells = <0x01>;
        #size-cells = "", "", "", "";
        port@0 {
          #address-cells = <0x01>;
          #size-cells = "", "", "", "";
          reg = "", "", "", "";
          phandle = <0x61>;
          endpoint@0 {
            reg = "", "", "", "";
            remote-endpoint = <0x1c>;
            phandle = <0x18>;
          };
          endpoint@1 {
            reg = <0x01>;
            remote-endpoint = <0x1d>;
            phandle = <0x1a>;
          };
        };
        port@1 {
          #address-cells = <0x01>;
          #size-cells = "", "", "", "";
          reg = <0x01>;
          phandle = <0x62>;
          endpoint@1 {
            reg = <0x01>;
            remote-endpoint = <0x1e>;
            allwinner,tcon-channel = <0x01>;
            phandle = <0x42>;
          };
        };
      };
    };
    lcd-controller@1c0d000 {
      compatible = "allwinner,sun50i-a64-tcon-tv", "allwinner,sun8i-a83t-tcon-tv";
      reg = <0x1c0d000 0x1000>;
      interrupts = <0x00 0x57 0x04>;
      clocks = <0x02 0x30 0x02 0x65>;
      clock-names = "ahb", "tcon-ch1";
      resets = <0x02 0x19>;
      reset-names = "lcd";
      phandle = <0x63>;
      ports {
        #address-cells = <0x01>;
        #size-cells = "", "", "", "";
        port@0 {
          #address-cells = <0x01>;
          #size-cells = "", "", "", "";
          reg = "", "", "", "";
          phandle = <0x64>;
          endpoint@0 {
            reg = "", "", "", "";
            remote-endpoint = <0x1f>;
            phandle = <0x19>;
          };
          endpoint@1 {
            reg = <0x01>;
            remote-endpoint = <0x20>;
            phandle = <0x1b>;
          };
        };
        port@1 {
          #address-cells = <0x01>;
          #size-cells = "", "", "", "";
          reg = <0x01>;
          phandle = <0x65>;
          endpoint@1 {
            reg = <0x01>;
            remote-endpoint = <0x21>;
            phandle = <0x46>;
          };
        };
      };
    };
    video-codec@1c0e000 {
      compatible = "allwinner,sun50i-a64-video-engine";
      reg = <0x1c0e000 0x1000>;
      clocks = <0x02 0x2e 0x02 0x6a 0x02 0x5f>;
      clock-names = "ahb", "mod", "ram";
      resets = <0x02 0x17>;
      interrupts = <0x00 0x3a 0x04>;
      allwinner,sram = <0x22 0x01>;
    };
    mmc@1c0f000 {
      compatible = "allwinner,sun50i-a64-mmc";
      reg = <0x1c0f000 0x1000>;
      clocks = <0x02 0x1f 0x02 0x4b>;
      clock-names = "ahb", "mmc";
      resets = <0x02 0x08>;
      reset-names = "ahb";
      interrupts = <0x00 0x3c 0x04>;
      max-frequency = <0x8f0d180>;
      status = "okay";
      bus-width = <0x04>;
      #address-cells = <0x01>;
      #size-cells = "", "", "", "";
      pinctrl-names = "default";
      pinctrl-0 = <0x23>;
      vmmc-supply = <0x04>;
      cd-gpios = <0x24 0x05 0x06 0x01>;
      disable-wp;
      phandle = <0x66>;
    };
    mmc@1c10000 {
      compatible = "allwinner,sun50i-a64-mmc";
      reg = <0x1c10000 0x1000>;
      clocks = <0x02 0x20 0x02 0x4c>;
      clock-names = "ahb", "mmc";
      resets = <0x02 0x09>;
      reset-names = "ahb";
      interrupts = <0x00 0x3d 0x04>;
      max-frequency = <0x8f0d180>;
      status = "okay";
      #address-cells = <0x01>;
      #size-cells = "", "", "", "";
      pinctrl-names = "default";
      pinctrl-0 = <0x25>;
      vmmc-supply = <0x26>;
      vqmmc-supply = <0x27>;
      mmc-pwrseq = <0x28>;
      bus-width = <0x04>;
      non-removable;
      phandle = <0x67>;
      wifi@1 {
        reg = <0x01>;
        interrupt-parent = <0x29>;
        interrupts = <0x00 0x03 0x08>;
        interrupt-names = "host-wake";
        phandle = <0x68>;
      };
    };
    mmc@1c11000 {
      compatible = "allwinner,sun50i-a64-emmc";
      reg = <0x1c11000 0x1000>;
      clocks = <0x02 0x21 0x02 0x4d>;
      clock-names = "ahb", "mmc";
      resets = <0x02 0x0a>;
      reset-names = "ahb";
      interrupts = <0x00 0x3e 0x04>;
      max-frequency = <0x8f0d180>;
      status = "okay";
      #address-cells = <0x01>;
      #size-cells = "", "", "", "";
      pinctrl-names = "default";
      pinctrl-0 = <0x2a 0x2b>;
      vmmc-supply = <0x04>;
      vqmmc-supply = <0x2c>;
      bus-width = <0x08>;
      non-removable;
      mmc-hs200-1_8v;
      mmc-hs400-1_8v;
      cap-mmc-hw-reset;
      phandle = <0x69>;
    };
    eeprom@1c14000 {
      compatible = "allwinner,sun50i-a64-sid";
      reg = <0x1c14000 0x400>;
      #address-cells = <0x01>;
      #size-cells = <0x01>;
      phandle = <0x6a>;
      thermal-sensor-calibration@34 {
        reg = <0x34 0x08>;
        phandle = <0x34>;
      };
      ephy-calib@2c {
        reg = <0x2c 0x02>;
        phandle = <0xb8>;
      };
      ac200-bg@30 {
        reg = <0x30 0x02>;
        phandle = <0xb7>;
      };
    };
    crypto@1c15000 {
      compatible = "allwinner,sun50i-a64-crypto";
      reg = <0x1c15000 0x1000>;
      interrupts = <0x00 0x5e 0x04>;
      clocks = <0x02 0x1d 0x02 0x4f>;
      clock-names = "bus", "mod";
      resets = <0x02 0x06>;
      phandle = <0x6b>;
    };
    mailbox@1c17000 {
      compatible = "allwinner,sun50i-a64-msgbox", "allwinner,sun6i-a31-msgbox";
      reg = <0x1c17000 0x1000>;
      clocks = <0x02 0x36>;
      resets = <0x02 0x20>;
      interrupts = <0x00 0x31 0x04>;
      #mbox-cells = <0x01>;
      phandle = <0x6c>;
    };
    usb@1c19000 {
      compatible = "allwinner,sun8i-a33-musb";
      reg = <0x1c19000 0x400>;
      clocks = <0x02 0x29>;
      resets = <0x02 0x12>;
      interrupts = <0x00 0x47 0x04>;
      interrupt-names = "mc";
      phys = "", "", "", "-", "", "", "";
      phy-names = "usb";
      extcon = "", "", "", "-", "", "", "";
      dr_mode = "host";
      status = "okay";
      phandle = <0x6d>;
    };
    phy@1c19400 {
      compatible = "allwinner,sun50i-a64-usb-phy";
      reg = <0x1c19400 0x14 0x1c1a800 0x04 0x1c1b800 0x04>;
      reg-names = "phy_ctrl", "pmu0", "pmu1";
      clocks = <0x02 0x56 0x02 0x57>;
      clock-names = "usb0_phy", "usb1_phy";
      resets = <0x02 0x00 0x02 0x01>;
      reset-names = "usb0_reset", "usb1_reset";
      status = "okay";
      #phy-cells = <0x01>;
      usb0_vbus-supply = <0x2e>;
      usb1_vbus-supply = <0x2e>;
      phandle = <0x2d>;
    };
    usb@1c1a000 {
      compatible = "allwinner,sun50i-a64-ehci", "generic-ehci";
      reg = <0x1c1a000 0x100>;
      interrupts = <0x00 0x48 0x04>;
      clocks = <0x02 0x2c 0x02 0x2a 0x02 0x5b>;
      resets = <0x02 0x15 0x02 0x13>;
      phys = "", "", "", "-", "", "", "";
      phy-names = "usb";
      status = "okay";
      phandle = <0x6e>;
    };
    usb@1c1a400 {
      compatible = "allwinner,sun50i-a64-ohci", "generic-ohci";
      reg = <0x1c1a400 0x100>;
      interrupts = <0x00 0x49 0x04>;
      clocks = <0x02 0x2c 0x02 0x5b>;
      resets = <0x02 0x15>;
      phys = "", "", "", "-", "", "", "";
      phy-names = "usb";
      status = "okay";
      phandle = <0x6f>;
    };
    usb@1c1b000 {
      compatible = "allwinner,sun50i-a64-ehci", "generic-ehci";
